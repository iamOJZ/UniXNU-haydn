# Qualcomm SM8350 shared kernel settings.
#
# Adreno 660 (SM8350) has no native Metal implementation in UniXNU yet:
# Adreno740/AdrenoMetal target A740 + SM8550 interfaces only.
# CONFIG_XNU_NATIVE_ADRENO is not set

# CONFIG_XNU_NATIVE_UFS is left to the board defconfig: haydn enables it for
# hardware bring-up (refusal-only owner-root stub, see configs/haydn_defconfig).
