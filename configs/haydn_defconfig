# haydn (SM8350) kernel configuration.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# Building the ordered component archives (RamBlock/VirtioMmioBlock/...) needs
# this; it drives scripts/build-arm-driver.py over the compile records.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_ARMVIRT_PLATFORM=n
# The BCM2837 personality compiles in the Raspberry Pi panic-log address
# (0x3c0fc000) and PE_create_console maps and reads it unconditionally, which is
# a data abort on SM8350. Switch to the device-tree "pram" node instead: this
# board has no such node, so the check returns early.
CONFIG_XNU_DT_PANIC_REGION=y
# Publish a provider-less ApplePMGRNub from bsd_init so AMFI's
# ConfigurationSettings latch succeeds (haydn_pmgr in package/).
CONFIG_XNU_SHENG_PMGR=y
# SM8350 UFS transport (fork of ShengUfs, drivers/ShengUfs). Enabling it
# force-loads build/sheng-ufs/libShengUfs.a and defines XNU_NATIVE_UFS=1.
#
# The driver is compiled with NATIVE_VERIFIED_BLOCK=1, so the verified-block paths
# reference the owner-root symbols that only the audited libVerifiedRootProbe.a
# defines (that archive comes from a prior audit of the real OS image, which this
# board has no evidence for). build-haydn-root-stub.py supplies them as a
# refusal-only placeholder: zero policies, crypto that always fails, so no byte is
# ever authenticated. That keeps the hardware probes usable
# (native-ufs-probe=2/10/11) without pretending to have a trust root.
# The block/root layer is compiled out for bring-up. IOBlockStorageDevice lives in
# the IOStorageFamily kext that this prelinked kernel already carries; compiling a
# second copy into __kernel__ panics on iOS with a duplicate class name
# (OSMetaClass.cpp:896), and binding to the kext's loaded addresses needs the
# interface-audit recording this board has no evidence for. The hardware probes
# (native-ufs-probe=2/7/8/10/11) do not touch that layer.
#
# build-haydn-storage-abi.py stays in the repository but must not be linked while
# this is set; re-enabling the root path requires the audited binding, not a
# recompile.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_UFS_PROBE_ONLY=y
# SM8350's GCC ends at 0x9c100 and has no UFS MEM PHY GDSC block; the SM8550
# 0x9e000 read in NativeUfs::inspect() is a synchronous external abort here.
CONFIG_XNU_UFS_SM8350=y
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/haydn-root-stub/libHaydnRootStub.a"
# GPU and display drivers are not adapted for haydn yet.
# CONFIG_XNU_NATIVE_ADRENO is not set
